# =============================================================================
# DeepSeek-V4-Flash-DSpark — validated 1M NVFP4 mseq6 lane
# Source: derived 1M/NVFP4 community repo review, ported as an isolated
# profile. Stage C uses the padded 584-byte DeepSeek V4 sparse-MLA envelope.
# =============================================================================

# ---- Image + entrypoint ----
VLLM_IMAGE=vllm-dspark-runtime:clean
ENTRYPOINT_FILE=./entrypoints/entrypoint.dspark.sh

# ---- Model ----
MODEL_PATH=/home/pieter/.cache/huggingface-dspark/models--deepseek-ai--DeepSeek-V4-Flash-DSpark
MODEL_CONTAINER_PATH=/models/DeepSeek-V4-Flash-DSpark/snapshots/913f0657a874f76844e2e91cbe706dbcaceeb6d7
MODEL_MOUNT_CONTAINER_PATH=/models/DeepSeek-V4-Flash-DSpark
SERVED_MODEL_NAME=deepseek-v4-flash-dspark

# ---- Cluster ----
CLUSTER_MODE=dual-rdma
TP_SIZE=2
HEAD_ROCE_IP=192.168.250.12
WORKER_ROCE_IP=192.168.250.13
ROCE_IF_NAME=enp1s0f1np1
IB_HCA_NAME=rocep1s0f1
DISTRIBUTED_BACKEND=mp

# ---- vLLM Serving ----
HOST_PORT=8000
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=6
KV_CACHE_DTYPE=nvfp4_ds_mla
GPU_MEMORY_UTILIZATION=0.80
MAX_NUM_BATCHED_TOKENS=8192
VLLM_LOG_STATS_INTERVAL=10.0

# The DSpark wrapper rewrites method=mtp to method=dspark in the inherited
# unholy entrypoint. Keep this at the DSpark paper/config block size.
MTP_NUM_TOKENS=5
VLLM_DSPARK_CONFIDENCE_THRESHOLD=0.0
VLLM_DSPARK_CONFIDENCE_SCHEDULER=off
VLLM_DSPARK_SPS_CURVE=
VLLM_DSPARK_HARDWARE_SCHEDULER_EARLY_STOP=1
VLLM_DSPARK_FORCE_DRAFT_LENGTH=
VLLM_DSPARK_STS_TEMPERATURES=
VLLM_DSPARK_COLLECT_CONFIDENCE_DIAGNOSTICS=0
VLLM_DSPARK_STS_CALIBRATION_DIAGNOSTICS=0
VLLM_DSPARK_POSITION0_DIAGNOSTICS=0
VLLM_DSPARK_LOCAL_ARGMAX=1
VLLM_DSPARK_REPLICATE_MARKOV_W1=1
VLLM_DSPARK_FUSED_MARKOV_ARGMAX=0
VLLM_DSPARK_GPU_REJECTED_CONTEXT_MASK=1
VLLM_DSPARK_REFERENCE_KV_QUANT_DEQUANT=0
VLLM_DSPARK_STAGE_TIMING=0
VLLM_DSPARK_STAGE_TIMING_LOG_EVERY=20
VLLM_DSPARK_CONFIDENCE_DIAGNOSTICS_LOG_EVERY=0
VLLM_DSPARK_ITER_TIMING=0
VLLM_DSPARK_ITER_TIMING_LOG_EVERY=20
VLLM_DSPARK_DRAFT_STREAM=1
VLLM_DSPARK_TARGET_TIMING=0
VLLM_DSPARK_TARGET_TIMING_LOG_EVERY=20
VLLM_DSV4_B12X_COMPRESSED_MLA=0
VLLM_CUSTOM_SCOPES_FOR_PROFILING=0
VLLM_DSV4_DSPARK_DEFER_TARGET_CAPTURE=0
VLLM_DSV4_DSPARK_DEFER_TARGET_CAPTURE_EXACT=0

# ---- Runtime env ----
TORCH_CUDA_ARCH_LIST=12.1a
FLASHINFER_CUDA_ARCH_LIST=12.1a
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
VLLM_TRITON_MLA_SPARSE=1
FLASHINFER_DISABLE_VERSION_CHECK=1
VLLM_ALLREDUCE_USE_FLASHINFER=0
VLLM_FLASHINFER_ALLREDUCE_BACKEND=auto
VLLM_FLASHINFER_ALLREDUCE_FUSION_THRESHOLDS_MB=
VLLM_ALLREDUCE_USE_SYMM_MEM=1
TILELANG_CLEANUP_TEMP_FILES=1
DG_JIT_USE_NVRTC=0
DG_JIT_NVCC_COMPILER=/opt/env/bin/nvcc
NCCL_IB_DISABLE=0
NCCL_DEBUG=WARN
NCCL_NVLS_ENABLE=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# ---- NCCL / RoCE tuning ----
NCCL_NET=IB
NCCL_CUMEM_ENABLE=0
NCCL_CROSS_NIC=1
NCCL_IGNORE_CPU_AFFINITY=1

# ---- NCCL SO + JIT cache ----
VLLM_NCCL_SO_PATH=/opt/env/lib/python3.12/site-packages/nvidia/nccl/lib/libnccl.so.2

# ---- B12X kernel switches ----
VLLM_USE_B12X_MOE=1
VLLM_USE_B12X_MHC=0
VLLM_USE_B12X_FP8_GEMM=0
VLLM_USE_B12X_SPARSE_INDEXER=0
VLLM_USE_B12X_WO_PROJECTION=0
VLLM_B12X_W4A16_FORCE_BLOCKS_PER_SM=0
VLLM_B12X_W4A16_FORCE_BLOCKS_MAX_M=16
VLLM_B12X_W4A16_FORCE_TILE_CONFIG=
B12X_W4A16_TC_DECODE=0

# ---- Disabled / inapplicable ----
VLLM_MARLIN_USE_ATOMIC_ADD=0
VLLM_USE_FLASHINFER_MOE_FP4=0
VLLM_SKIP_INIT_MEMORY_CHECK=1
VLLM_USE_BREAKABLE_CUDAGRAPH=0
VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0
