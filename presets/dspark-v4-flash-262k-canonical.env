# DeepSeek-V4-Flash-DSpark 262k canonical speed lane.
#
# This preset keeps only the knobs that define the current validated path.
# Diagnostics, rejected experiments, and one-off sweeps should be layered on by
# shell overrides instead of being kept as equal-weight defaults here.

# ---- Image + entrypoint ----
VLLM_IMAGE=vllm-dspark-runtime:clean
ENTRYPOINT_FILE=./entrypoints/entrypoint.dspark.sh

# ---- Model ----
MODEL_PATH=/home/pieter/.cache/huggingface-dspark/models--deepseek-ai--DeepSeek-V4-Flash-DSpark
MODEL_CONTAINER_PATH=/models/DeepSeek-V4-Flash-DSpark/snapshots/913f0657a874f76844e2e91cbe706dbcaceeb6d7
MODEL_MOUNT_CONTAINER_PATH=/models/DeepSeek-V4-Flash-DSpark
SERVED_MODEL_NAME=deepseek-v4-flash-dspark

# ---- Cluster ----
CLUSTER_MODE=dual-rdma
TP_SIZE=2
HEAD_ROCE_IP=192.168.250.12
WORKER_ROCE_IP=192.168.250.13
ROCE_IF_NAME=enp1s0f1np1
IB_HCA_NAME=rocep1s0f1
DISTRIBUTED_BACKEND=mp

# ---- vLLM serving envelope ----
HOST_PORT=8000
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=8192
KV_CACHE_DTYPE=fp8
GPU_MEMORY_UTILIZATION=0.80
VLLM_LOG_STATS_INTERVAL=10.0
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1

# ---- DSpark canonical path ----
MTP_NUM_TOKENS=5
VLLM_DSPARK_CONFIDENCE_SCHEDULER=off
VLLM_DSPARK_CONFIDENCE_THRESHOLD=0.0
VLLM_DSPARK_LOCAL_ARGMAX=1
VLLM_DSPARK_REPLICATE_MARKOV_W1=1
VLLM_DSPARK_GPU_REJECTED_CONTEXT_MASK=1

# Draft stream is the default DSpark evolution lane. The first safe overlap pass
# is modest, but keeping streams/events active gives future pipeline work the
# right execution shape.
VLLM_DSPARK_DRAFT_STREAM=1

# ---- Kernel/runtime choices that are settled on this lane ----
TORCH_CUDA_ARCH_LIST=12.1a
FLASHINFER_CUDA_ARCH_LIST=12.1a
FLASHINFER_DISABLE_VERSION_CHECK=1
VLLM_TRITON_MLA_SPARSE=1
VLLM_USE_B12X_MOE=1
VLLM_USE_B12X_WO_PROJECTION=1
VLLM_ALLREDUCE_USE_FLASHINFER=0
VLLM_FLASHINFER_ALLREDUCE_BACKEND=auto
VLLM_ALLREDUCE_USE_SYMM_MEM=1
TILELANG_CLEANUP_TEMP_FILES=1
DG_JIT_USE_NVRTC=0
DG_JIT_NVCC_COMPILER=/opt/env/bin/nvcc
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
VLLM_NCCL_SO_PATH=/opt/env/lib/python3.12/site-packages/nvidia/nccl/lib/libnccl.so.2

# ---- NCCL / RoCE tuning ----
NCCL_IB_DISABLE=0
NCCL_DEBUG=WARN
NCCL_NVLS_ENABLE=0
NCCL_NET=IB
NCCL_CUMEM_ENABLE=0
NCCL_CROSS_NIC=1
NCCL_IGNORE_CPU_AFFINITY=1

# ---- Guardrails ----
VLLM_MARLIN_USE_ATOMIC_ADD=0
VLLM_USE_FLASHINFER_MOE_FP4=0
VLLM_SKIP_INIT_MEMORY_CHECK=1
VLLM_USE_BREAKABLE_CUDAGRAPH=0
VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0
